# xGEOID20B Batch Extraction Tool
# .gitignore

# Output files — generated by script, not tracked
*_batch_log.txt

# input/ and output/ folders: track the README (and the provided sample
# files) but ignore user-supplied and generated data files.
input/*
!input/README.txt
!input/ak_example_input.csv
output/*
!output/README.txt
!output/ak_example_output.csv

# logs/ folder: track the README, ignore the generated batch logs.
logs/*
!logs/README.txt

# Internal LLM session notes — personal working notes, not committed.
*.claude

# GGXF grid file — ~403 MB, downloaded by user, never committed.
# The GGXF/README.txt is kept so the folder and instructions are tracked.
*.ggxf
GGXF/*
!GGXF/
!GGXF/README.txt

# HTDP: the htdp360.exe (~3 MB) and its README ARE committed with the
# project (small, released NGS software) — do not ignore them.

# Input/output CSVs — commented out to allow sample test file tracking
# *_input.csv
# *_output.csv

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Spyder
.spyderproject.cfg
.spyproject/

# Jupyter (if ever used)
.ipynb_checkpoints/

# Environment
.env
*.env
Miniconda3/
conda-meta/

# OS
.DS_Store
Thumbs.db
desktop.ini
